{
  "name": "friday",
  "version": "0.1.0",
  "description": "FRIDAY — local Windows automation agent",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:milestone": "vitest run tests/integration/milestone-tool-chain.test.ts",
    "test:browser": "vitest run tests/integration/playwright-browser.test.ts",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^10.0.1",
    "playwright": "^1.51.0",
    "three": "^0.186.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
