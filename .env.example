# Optional debugging (main process)
# FRIDAY_OLLAMA_DEBUG=1

# Integration tests (not used at runtime)
# RUN_BROWSER_TESTS=1
# RUN_OLLAMA_LIVE=1
# RUN_WINDOWS_DESKTOP_TESTS=1

# Ollama URL and model are configured in the in-app Settings panel (default http://localhost:11434, llama3.1).

# Optional memory backend (default: JSON in userData)
# FRIDAY_MEMORY=sqlite
